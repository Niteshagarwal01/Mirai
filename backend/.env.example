# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==========================================
# DATABASE (MongoDB Atlas)
# ==========================================
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/mirai?retryWrites=true&w=majority&appName=Mirai"

# ==========================================
# CLERK AUTHENTICATION
# ==========================================
# Get from: https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# ==========================================
# RAZORPAY PAYMENT GATEWAY
# ==========================================
# Get from: https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
# Get from: Settings → Webhooks (optional for local dev)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ==========================================
# PLAN PRICING (in paise - 1 INR = 100 paise)
# ==========================================
# Starter: ₹1,577 = 157,700 paise
STARTER_PLAN_PRICE=157700

# Professional: ₹3,237 = 323,700 paise
PROFESSIONAL_PLAN_PRICE=323700

# Enterprise: ₹6,557 = 655,700 paise
ENTERPRISE_PLAN_PRICE=655700

# ==========================================
# CHATBASE INTEGRATION
# ==========================================
# Get from: https://www.chatbase.co/dashboard
CHATBASE_API_KEY=your_chatbase_api_key_here

# ==========================================
# VAPI VOICE AGENT INTEGRATION
# ==========================================
# Get from: https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_api_key_here

# ==========================================
# BACK4APP INTEGRATION (Optional)
# ==========================================
# Get from: https://dashboard.back4app.com
BACK4APP_APPLICATION_ID=your_back4app_app_id
BACK4APP_JAVASCRIPT_KEY=your_back4app_js_key
BACK4APP_REST_API_KEY=your_back4app_rest_api_key