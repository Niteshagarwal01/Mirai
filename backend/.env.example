# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==========================================
# CLERK AUTHENTICATION
# ==========================================
# Get from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Admin Emails (comma-separated, for special access)
ADMIN_EMAILS=admin@mirai.com,nitesh@mirai.com

# ==========================================
# RAZORPAY PAYMENT GATEWAY
# ==========================================
# Get from: https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
# Get from: Settings → Webhooks (optional for local dev)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ==========================================
# PLAN PRICING (in paise - 1 INR = 100 paise)
# ==========================================
# Starter: ₹49 = 4,900 paise
STARTER_PLAN_PRICE=4900

# Professional: ₹149 = 14,900 paise
PROFESSIONAL_PLAN_PRICE=14900

# Enterprise: ₹399 = 39,900 paise
ENTERPRISE_PLAN_PRICE=39900

# ==========================================
# CHATBASE INTEGRATION
# ==========================================
# Get from: https://www.chatbase.co/dashboard
CHATBASE_API_KEY=your_chatbase_api_key_here

# ==========================================
# VAPI VOICE AGENT INTEGRATION
# ==========================================
# Get from: https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_api_key_here

# ==========================================
# EMAIL AUTOMATION (LangGraph Python Service)
# ==========================================
# Get from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
# Your Gmail address for sending emails
MY_EMAIL=your_email@gmail.com
# Optional: Groq API for Llama models
GROQ_API_KEY=your_groq_api_key_here